{
  "expo": {
    "name": "Cogana",
    "slug": "coguana-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cogana",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yhonq.coganaapp",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.yhonq.coganaapp",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F8F6EF",
          "dark": {
            "backgroundColor": "#132019"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-updates",
      [
        "expo-camera",
        {
          "cameraPermission": "Cogana usa la cámara para escanear productos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Cogana usa la cámara para registrar evidencia de entrega."
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6a1144d3-e291-4020-be46-8f8eab722341"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6a1144d3-e291-4020-be46-8f8eab722341"
      }
    },
    "owner": "yhonq",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}

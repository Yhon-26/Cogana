{
  "name": "cogana-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:database",
    "preflight": "node scripts/preflight.mjs",
    "preflight:ci": "node scripts/preflight.mjs --ci",
    "preflight:release": "node scripts/preflight.mjs --release",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web",
    "build:preview": "eas-cli build --profile preview --platform all",
    "build:production": "eas-cli build --profile production --platform all",
    "submit:production": "eas-cli submit --profile production --platform all",
    "pretest:database": "tsc -p tsconfig.tests.json",
    "test:database": "node --test .test-dist/tests/migrations.test.js .test-dist/tests/inventory-movements.test.js .test-dist/tests/product-management.test.js .test-dist/tests/presentations.test.js .test-dist/tests/price-updates.test.js .test-dist/tests/cash-sessions.test.js .test-dist/tests/cash-differences.test.js .test-dist/tests/app-preferences.test.js .test-dist/tests/sales.test.js .test-dist/tests/sales-voids.test.js .test-dist/tests/sales-returns.test.js .test-dist/tests/reports.test.js .test-dist/tests/persistence.test.js .test-dist/tests/suppliers.test.js .test-dist/tests/procurement.test.js .test-dist/tests/personnel-operations.test.js .test-dist/tests/delivery-zones.test.js .test-dist/tests/orders.test.js .test-dist/tests/operator-auth.test.js .test-dist/tests/operator-route-access.test.js .test-dist/tests/payment-validation.test.js .test-dist/tests/customer-auth-validation.test.js .test-dist/tests/user-facing-error.test.js .test-dist/tests/online-cart.test.js .test-dist/tests/sync.test.js"
  },
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.110.8",
    "expo": "~54.0.37",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-local-authentication": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@types/invariant": "^2.2.37",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
